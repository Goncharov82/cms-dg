{
  "name": "cms-dg",
  "version": "1.0.0",
  "description": "Rails-monolith для публичного сайта, административной панели и будущих CMS/API/CRM-модулей. На первом этапе реализованы технический фундамент, Rails-native authentication и каркас админки.",
  "private": true,
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "build:tiptap": "esbuild app/javascript/vendor/tiptap.js --bundle --format=esm --minify --outfile=vendor/javascript/tiptap.js",
    "build:codemirror": "esbuild app/javascript/vendor/codemirror.js --bundle --format=esm --minify --outfile=vendor/javascript/codemirror.js",
    "build:editors": "npm run build:tiptap && npm run build:codemirror"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goncharov82/cms-dg.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Goncharov82/cms-dg/issues"
  },
  "homepage": "https://github.com/Goncharov82/cms-dg#readme",
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/theme-one-dark": "6.1.3",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-image": "3.30.1",
    "@tiptap/extension-table": "3.30.1",
    "@tiptap/pm": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
