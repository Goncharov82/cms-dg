<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "Goncharoff.pro" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="view-transition" content="same-origin">
    <meta name="application-name" content="Goncharoff.pro">
    <% if content_for?(:meta_description) %><meta name="description" content="<%= content_for(:meta_description) %>"><% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <%= render "shared/flash" %>
    <%= yield %>
  </body>
</html>
