<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "Панель управления — Goncharoff.pro" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-body" data-controller="sidebar theme" data-theme="light">
    <div class="admin-shell">
      <%= render "admin/shared/sidebar" %>
      <div class="admin-stage">
        <header class="admin-topbar">
          <button type="button" class="mobile-menu-button" data-action="sidebar#open" aria-label="Открыть меню">
            <%= admin_icon(:menu) %>
          </button>
          <% if content_for?(:admin_section_title) %>
            <h1 class="admin-topbar-title">
              <% if content_for?(:admin_section_icon) %><span class="admin-topbar-title-icon"><%= content_for(:admin_section_icon) %></span><% end %>
              <span><%= content_for(:admin_section_title) %></span>
            </h1>
          <% else %>
            <span class="mobile-brand">DG CMS</span>
          <% end %>

          <%= link_to root_path, class: "open-site-link", target: "_blank", rel: "noopener", aria: { label: "Открыть главную страницу сайта в новой вкладке" } do %>
            <span>Открыть сайт</span><%= admin_icon(:external) %>
          <% end %>
          <div class="theme-switch" role="group" aria-label="Тема оформления">
            <button type="button" class="theme-button" data-theme-target="lightButton" data-action="theme#light" aria-label="Включить светлую тему"><%= admin_icon(:sun) %></button>
            <button type="button" class="theme-button" data-theme-target="darkButton" data-action="theme#dark" aria-label="Включить тёмную тему"><%= admin_icon(:moon) %></button>
          </div>
          <details class="profile-menu" data-controller="dismissible-details">
            <summary class="profile-trigger">
              <span class="profile-avatar"><%= admin_display_name(current_user).first %></span>
              <span class="profile-name"><%= admin_display_name(current_user) %></span>
              <%= admin_icon(:chevron_down, class_name: "profile-chevron") %>
            </summary>
            <div class="profile-dropdown">
              <span class="profile-dropdown-link is-disabled">Профиль</span>
              <%= link_to "Настройки", admin_settings_path, class: "profile-dropdown-link" %>
              <div class="profile-divider"></div>
              <%= button_to session_path, method: :delete, class: "profile-dropdown-link profile-logout" do %>
                <span>Выйти</span><%= admin_icon(:logout) %>
              <% end %>
            </div>
          </details>
        </header>
        <main class="admin-main">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
