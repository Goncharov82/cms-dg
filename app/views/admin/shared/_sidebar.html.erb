<div class="sidebar-backdrop hidden" data-sidebar-target="backdrop" data-action="click->sidebar#close"></div>
<aside class="admin-sidebar" data-sidebar-target="panel">
  <div class="sidebar-brand-row">
    <%= link_to admin_root_path, class: "brand-lockup", aria: { label: "DG CMS" } do %>
      <span class="brand-mark"><span class="brand-d">D</span><span class="brand-g">G</span></span>
      <span class="brand-title">DG CMS</span>
    <% end %>
    <button type="button" class="sidebar-close" data-action="sidebar#close" aria-label="Закрыть меню"><%= admin_icon(:close) %></button>
  </div>

  <nav class="sidebar-nav">
    <button type="button" class="sidebar-collapse-control" data-sidebar-target="collapseButton" data-action="sidebar#toggleCollapsed" aria-label="Скрыть меню" title="Скрыть меню">
      <%= admin_icon(:eye, class_name: "sidebar-icon") %><span data-sidebar-target="collapseLabel">Скрыть меню</span>
    </button>
    <%= render "admin/shared/nav_item", label: "Дашборд", icon: :dashboard, path: admin_root_path %>
    <%= render "admin/shared/nav_item", label: "Категории", icon: :folder, path: admin_categories_path %>
    <%= render "admin/shared/nav_item", label: "Статьи", icon: :articles, path: admin_articles_path %>
    <%= render "admin/shared/nav_item", label: "Страницы", icon: :page, path: admin_pages_path %>
    <%= render "admin/shared/nav_item", label: "Меню сайта", icon: :menu, path: admin_site_menu_path %>
    <%= render "admin/shared/nav_item", label: "Медиафайлы", icon: :image %>
    <%= render "admin/shared/nav_item", label: "Аналитика", icon: :chart, path: admin_analytics_path %>
  </nav>

  <div class="sidebar-footer">
    <%= render "admin/shared/nav_item", label: "Настройки", icon: :settings, path: admin_settings_path %>
  </div>
</aside>
