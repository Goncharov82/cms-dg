<%= form_with model: [:admin, menu_item], data: { controller: "menu-item-form" } do |form| %>
<div class="admin-container"><div class="editor-breadcrumb"><%= link_to "Меню сайта", admin_site_menu_path %> <span>/</span> Главное меню <span>/</span> <%= menu_item.persisted? ? "Редактирование пункта" : "Добавление пункта" %></div>
<div class="editor-heading"><h1><%= menu_item.persisted? ? "Редактирование пункта меню" : "Добавление пункта меню" %></h1><%= render "admin/shared/editor_actions", cancel_path: admin_site_menu_path, primary_label: "Сохранить", primary_value: "save" %></div>
<%= form.hidden_field :item_type, data: { menu_item_form_target: "typeValue" } %>
<div class="menu-item-editor-grid"><section class="editor-card menu-main-panel"><h2>Основные данные</h2>
<div class="form-field"><%= form.label :label, "Название пункта *" %><%= form.text_field :label, class: "form-input", data: { menu_item_form_target: "label", action: "input->menu-item-form#update" } %></div>
<div class="form-field"><%= form.label :slug, "Алиас *" %><%= form.text_field :slug, class: "form-input", data: { menu_item_form_target: "slug", action: "input->menu-item-form#lockSlug" } %><p class="form-hint">Формируется автоматически из названия. При необходимости его можно изменить вручную.</p></div>
<h3 class="menu-section-title">Куда ведёт пункт меню</h3><div class="target-type-grid"><% [["page","Страница",:page],["category","Категория",:folder],["article","Статья",:articles],["external","Внешняя ссылка",:link]].each do |type,label,icon| %><button type="button" class="target-type-card <%= "is-active" if type == menu_item.item_type %>" data-type="<%= type %>" data-menu-item-form-target="typeButton" data-action="menu-item-form#selectType"><%= admin_icon(icon) %><span><%= label %></span></button><% end %></div>
<div class="target-panel" data-menu-item-form-type="page" data-menu-item-form-target="targetPanel"><div class="form-field"><label>Связанная страница *</label><%= form.text_field :target_label, class: "form-input", placeholder: "О компании", data: { menu_item_form_target: "targetLabel", action: "input->menu-item-form#update" } %></div></div>
<div class="target-panel" data-menu-item-form-type="category" data-menu-item-form-target="targetPanel" hidden><div class="form-field"><%= form.label :target_id, "Связанная категория или подкатегория *" %><%= form.select :target_id, options_for_select(content_scope(Category).order(:name).map { |category| [category.full_name, category.id, { "data-slug": category.slug }] }, menu_item.target_id), { include_blank: "Выберите категорию" }, class: "form-select", data: { menu_item_form_target: "targetCategory", action: "change->menu-item-form#selectCategory" } %></div></div>
<div class="target-panel" data-menu-item-form-type="article" data-menu-item-form-target="targetPanel" hidden><div class="form-field"><label>Связанная статья *</label><%= form.text_field :target_label, class: "form-input", placeholder: "Как создать SEO-статью: пошаговое руководство", data: { menu_item_form_target: "targetLabel", action: "input->menu-item-form#update" } %></div></div>
<div class="target-panel" data-menu-item-form-type="external" data-menu-item-form-target="targetPanel" hidden><div class="form-field"><%= form.label :url, "Адрес внешней ссылки *" %><%= form.url_field :url, class: "form-input", placeholder: "https://", data: { menu_item_form_target: "targetUrl", action: "input->menu-item-form#update" } %></div></div>
<h3 class="menu-section-title">Отображение</h3><div class="form-field"><%= form.label :description, "Подпись пункта" %><%= form.text_area :description, class: "form-textarea", rows: 3, data: { menu_item_form_target: "description", action: "input->menu-item-form#updateCount" } %></div></section>
<aside class="menu-item-sidebar-stack"><section class="editor-card"><h2>Публикация</h2><div class="form-field"><%= form.label :status, "Статус" %><%= form.select :status, [["Черновик", "draft"], ["Опубликовано", "published"]], {}, class: "form-select" %></div><div class="form-field"><%= form.label :visibility, "Доступ" %><%= form.select :visibility, admin_access_options, {}, class: "form-select" %></div><div class="saved-indicator">✓ Изменения сохранены</div></section><section class="editor-card"><h2>Расположение</h2><div class="form-field"><%= form.label :parent_label, "Родительский пункт" %><%= form.text_field :parent_label, class: "form-input", placeholder: "Без родительского пункта" %></div></section><section class="editor-card behavior-card"><h2>Поведение</h2><% [[ :open_new_tab,"Открывать в новой вкладке"],[ :nofollow,"Добавить rel=nofollow"],[ :hide_mobile,"Скрыть на мобильных устройствах"]].each do |field,label| %><label class="toggle-label"><%= form.check_box field %><span></span><%= label %></label><% end %></section></aside></div></div><% end %>
