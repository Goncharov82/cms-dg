<%= form_with model: [:admin, menu_item], data: { controller: "menu-item-form" } do |form| %>
<div class="admin-container"><div class="editor-breadcrumb"><%= link_to "Меню сайта", admin_site_menu_path %> <span>/</span> Главное меню <span>/</span> Добавление пункта</div>
<div class="editor-heading"><h1>Добавление пункта меню</h1><div class="editor-actions"><%= link_to "Отмена", admin_site_menu_path, class: "editor-cancel" %><%= form.submit "Сохранить черновик", name: "submit_action", value: "draft", class: "admin-button is-outline" %><%= form.submit "Добавить пункт", name: "submit_action", value: "published", class: "admin-button is-primary" %></div></div>
<%= form.hidden_field :item_type, data: { menu_item_form_target: "typeValue" } %>
<div class="menu-item-editor-grid"><section class="editor-card menu-main-panel"><h2>Основные данные</h2>
<div class="form-field"><%= form.label :label, "Название пункта *" %><%= form.text_field :label, class: "form-input", data: { menu_item_form_target: "label", action: "input->menu-item-form#update" } %></div>
<div class="form-field"><%= form.label :slug, "Алиас *" %><div class="alias-row"><%= form.text_field :slug, class: "form-input", data: { menu_item_form_target: "slug" } %><button type="button" class="admin-button is-outline" data-action="menu-item-form#generateSlug">Сформировать</button></div></div>
<h3 class="menu-section-title">Куда ведёт пункт меню</h3><div class="target-type-grid"><% [["page","Страница",:page],["category","Категория",:folder],["article","Статья",:articles],["external","Внешняя ссылка",:link]].each do |type,label,icon| %><button type="button" class="target-type-card <%= "is-active" if type == "page" %>" data-type="<%= type %>" data-menu-item-form-target="typeButton" data-action="menu-item-form#selectType"><%= admin_icon(icon) %><span><%= label %></span></button><% end %></div>
<% [["page","Связанная страница *","О компании"],["category","Связанная категория или подкатегория *","Блог / Нейросети"],["article","Связанная статья *","Как создать SEO-статью: пошаговое руководство"]].each do |type,label,placeholder| %><div class="target-panel" data-menu-item-form-type="<%= type %>" data-menu-item-form-target="targetPanel" <%= "hidden" unless type == "page" %>><div class="form-field"><label><%= label %></label><%= form.text_field :target_label, class: "form-input", placeholder: placeholder, data: { menu_item_form_target: "targetLabel", action: "input->menu-item-form#update" } %></div></div><% end %>
<div class="target-panel" data-menu-item-form-type="external" data-menu-item-form-target="targetPanel" hidden><div class="form-field"><%= form.label :url, "Адрес внешней ссылки *" %><%= form.url_field :url, class: "form-input", placeholder: "https://", data: { menu_item_form_target: "targetUrl", action: "input->menu-item-form#update" } %></div></div>
<div class="form-field"><label>Адрес ссылки</label><%= form.text_field :url, class: "form-input", data: { menu_item_form_target: "url" }, readonly: true %></div><h3 class="menu-section-title">Отображение</h3><div class="form-field"><%= form.label :description, "Подпись пункта" %><%= form.text_area :description, class: "form-textarea", rows: 3, data: { menu_item_form_target: "description", action: "input->menu-item-form#updateCount" } %></div><div class="form-field"><label>Предпросмотр</label><div class="menu-preview" data-menu-item-form-target="preview"><span>О компании</span><%= admin_icon(:chevron_right) %></div></div></section>
<aside class="menu-item-sidebar-stack"><section class="editor-card"><h2>Публикация</h2><div class="form-field"><label>Статус</label><select class="form-select"><option>Опубликовано</option><option selected>Черновик</option></select></div><div class="form-field"><%= form.label :visibility, "Видимость" %><%= form.select :visibility, [["Публичный","public"],["Приватный","private"]], {}, class: "form-select" %></div><div class="saved-indicator">✓ Изменения сохранены</div></section><section class="editor-card"><h2>Расположение в меню</h2><div class="form-field"><label>Меню</label><select class="form-select"><option>Главное меню</option></select></div><div class="form-field"><%= form.label :parent_label, "Родительский пункт" %><%= form.text_field :parent_label, class: "form-input", placeholder: "Без родительского пункта" %></div></section><section class="editor-card behavior-card"><h2>Поведение</h2><% [[ :open_new_tab,"Открывать в новой вкладке"],[ :nofollow,"Добавить rel=nofollow"],[ :hide_mobile,"Скрыть на мобильных устройствах"]].each do |field,label| %><label class="toggle-label"><%= form.check_box field %><span></span><%= label %></label><% end %></section></aside></div></div><% end %>
