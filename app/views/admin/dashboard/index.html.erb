<% content_for :title, "Дашборд — DG CMS" %>
<% content_for :admin_section_title, "Дашборд" %>
<% content_for :admin_section_icon do %><%= admin_icon(:dashboard) %><% end %>

<div class="admin-container">
  <div class="stats-grid">
    <% @stats.each do |stat| %>
      <%= render "admin/shared/stat_card", **stat %>
    <% end %>
  </div>

  <div class="dashboard-grid">
    <section class="panel materials-panel">
      <div class="panel-heading">
        <h2>Последние материалы</h2>
        <%= link_to admin_articles_path, class: "orange-link" do %>Все статьи <%= admin_icon(:chevron_right) %><% end %>
      </div>
      <div class="materials-table-wrap">
        <table class="materials-table">
          <thead><tr><th>Заголовок</th><th>Статус</th><th>Дата</th></tr></thead>
          <tbody>
            <% if @recent_articles.any? %>
              <% @recent_articles.each do |article| %>
                <tr>
                  <td><%= link_to article.rendered_title, edit_admin_article_path(article), class: "material-title" %><span class="material-category"><span>Категория:</span> <%= article.category&.rendered_name || "—" %></span></td>
                  <td><span class="status-badge is-<%= article.status %>"><%= article.published? ? "Опубликовано" : "Черновик" %></span></td>
                  <td class="material-date"><%= (article.published_at || article.created_at).strftime("%d.%m.%Y") %></td>
                </tr>
              <% end %>
            <% else %>
              <tr><td colspan="3"><div class="empty-row"><span class="empty-icon"><%= admin_icon(:articles) %></span><strong>Материалов пока нет</strong><span>Создайте первую статью — она появится в этом списке.</span></div></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <aside class="panel quick-panel">
      <div class="panel-heading"><h2>Быстрые действия</h2></div>
      <div class="quick-actions">
        <%= link_to new_admin_article_path, class: "quick-action is-primary" do %><%= admin_icon(:page) %><span>Создать статью</span><% end %>
        <span class="quick-action is-disabled"><%= admin_icon(:page) %><span>Добавить страницу</span><small>Скоро</small></span>
        <span class="quick-action is-disabled"><%= admin_icon(:upload) %><span>Загрузить медиа</span><small>Скоро</small></span>
      </div>
    </aside>
  </div>
</div>
