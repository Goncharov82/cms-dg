<%= form_with model: [:admin, category], data: { controller: "category-form" }, class: "category-editor-form" do |form| %>
  <div class="editor-breadcrumb"><%= link_to "Категории", admin_categories_path %><span>/</span><span>Добавление категории</span></div>
  <div class="editor-heading"><h1>Добавление категории</h1><div class="editor-actions"><%= link_to "Отмена", admin_categories_path, class: "editor-cancel" %><button type="submit" name="submit_action" value="draft" class="admin-button is-outline">Сохранить черновик</button><button type="submit" name="submit_action" value="published" class="admin-button is-primary">Опубликовать</button></div></div>

  <% if category.errors.any? %><div class="error-box"><strong>Проверьте заполнение формы:</strong><ul><% category.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>

  <div class="category-editor-grid" data-controller="tabs">
    <section class="editor-card">
      <div class="editor-tabs"><button type="button" class="is-active" data-tabs-target="tab" data-tabs-name="main" data-action="tabs#show">Основное</button><button type="button" data-tabs-target="tab" data-tabs-name="seo" data-action="tabs#show">SEO</button></div>

      <div class="editor-panel category-main-panel" data-tabs-target="panel" data-tabs-name="main">
        <div class="form-field"><%= form.label :name, "Название категории *" %><%= form.text_field :name, class: "form-input", placeholder: "Например, Нейросети", autofocus: true, data: { category_form_target: "name", action: "input->category-form#suggestSlug" } %></div>
        <div class="form-field"><%= form.label :slug, "Алиас *" %><div class="alias-row"><%= form.text_field :slug, class: "form-input", placeholder: "neyroseti", data: { category_form_target: "slug", action: "input->category-form#lockSlug" } %><button type="button" class="admin-button" data-action="category-form#generateSlug"><span class="refresh-symbol">↻</span>Сформировать</button></div><p class="form-hint">goncharoff.pro/blog/<span data-category-form-target="slugPreview">adres-kategorii</span></p></div>
        <div class="form-field"><%= form.label :parent_id, "Родительская категория" %><%= form.collection_select :parent_id, Category.order(:name), :id, :name, { include_blank: "Без родительской категории" }, class: "form-select" %><p class="form-hint">Используется для вложенной структуры разделов.</p></div>
        <div class="form-field field-with-count"><%= form.label :short_description, "Краткое описание" %><%= form.text_area :short_description, class: "form-textarea category-short-description", maxlength: 300, placeholder: "Краткое описание категории", data: { category_form_target: "shortDescription", action: "input->category-form#updateCount input->category-form#updateSeo" } %><span data-category-form-target="descriptionCount">0 / 300</span><p class="form-hint">Отображается в карточках и списках категорий.</p></div>
        <div class="form-field"><%= form.label :description, "Описание категории" %><div class="editor-toolbar rich-toolbar"><button type="button" disabled>Абзац⌄</button><button type="button" disabled>H2</button><button type="button" disabled>H3</button><button type="button" disabled><strong>B</strong></button><button type="button" disabled><em>I</em></button><button type="button" disabled><u>U</u></button><button type="button" disabled>🔗</button><button type="button" disabled>• Список</button><button type="button" disabled>❝</button></div><%= form.text_area :description, class: "form-textarea category-description", placeholder: "Подробное описание категории" %></div>
        <div class="category-image-box"><strong>Изображение категории</strong><label class="upload-dropzone"><%= admin_icon(:image) %><span>Перетащите изображение или <em>выберите файл</em><small>JPEG, PNG до 10 МБ · будет преобразовано в WebP</small></span><%= form.file_field :image, accept: "image/jpeg,image/png,image/webp" %></label><label class="toggle-label"><%= form.check_box :use_for_open_graph %><span></span>Использовать для Open Graph</label></div>
      </div>

      <div class="editor-panel" data-tabs-target="panel" data-tabs-name="seo" hidden>
        <section class="seo-preview-box"><div class="seo-preview-heading"><strong>Предпросмотр в поиске</strong></div><div class="search-result"><div class="search-site"><span class="search-favicon">DG</span><span><strong>goncharoff.pro</strong><span>https://goncharoff.pro/blog/<span data-category-form-target="seoSlugPreview">adres-kategorii</span></span></span></div><div class="search-title" data-category-form-target="seoTitlePreview">Название категории</div><p data-category-form-target="seoDescriptionPreview">Описание категории для поисковой выдачи.</p></div></section>
        <div class="form-field field-with-count"><%= form.label :seo_title, "SEO Title" %><%= form.text_field :seo_title, class: "form-input", maxlength: 60, placeholder: "Если пусто, используется название категории", data: { category_form_target: "seoTitle", action: "input->category-form#updateSeo" } %></div>
        <div class="form-field field-with-count"><%= form.label :meta_description, "Meta Description" %><%= form.text_area :meta_description, class: "form-textarea seo-description", maxlength: 160, placeholder: "Описание категории в поисковой выдаче", data: { category_form_target: "metaDescription", action: "input->category-form#updateSeo" } %></div>
        <div class="form-field"><%= form.label :canonical_url, "Canonical URL" %><%= form.url_field :canonical_url, class: "form-input", placeholder: "https://goncharoff.pro/blog/adres-kategorii" %></div>
      </div>
    </section>

    <aside class="category-sidebar-stack">
      <section class="publication-card"><h2>Публикация</h2><div class="form-field"><%= form.label :status, "Статус" %><%= form.select :status, [["Черновик", "draft"], ["Опубликовано", "published"]], {}, class: "form-select" %></div><div class="form-field"><%= form.label :visibility, "Видимость" %><%= form.select :visibility, [["Публичная", "public"], ["Скрытая", "hidden"]], {}, class: "form-select" %></div><div class="saved-indicator"><span><%= admin_icon(:check) %></span>Данные сохранятся после отправки формы</div></section>
      <section class="publication-card output-settings"><h2>Вывод материалов</h2><div class="form-field"><%= form.label :articles_sort, "Сортировка статей" %><%= form.select :articles_sort, [["Сначала новые", "newest"], ["Сначала старые", "oldest"], ["По алфавиту", "alphabetical"]], {}, class: "form-select" %></div><div class="form-field"><%= form.label :articles_per_page, "Статей на странице" %><%= form.select :articles_per_page, [6, 9, 12, 18, 24], {}, class: "form-select" %></div><label class="toggle-label"><%= form.check_box :show_description %><span></span>Показывать описание категории</label><label class="toggle-label"><%= form.check_box :show_image %><span></span>Показывать изображение категории</label><p class="form-hint output-hint">Настройки применяются только к этой категории.</p></section>
    </aside>
  </div>
<% end %>
