<% content_for :title, "Аналитика — DG CMS" %>
<div class="admin-container"><div class="page-heading"><div><p class="page-eyebrow">Статистика</p><h1>Аналитика</h1></div><div class="page-heading-actions"><button class="admin-button" disabled><%= admin_icon(:calendar) %><span>Последние 30 дней</span></button><button class="admin-button" disabled><%= admin_icon(:upload) %><span>Экспорт</span></button></div></div>
  <div class="analytics-stats"><%= render "admin/shared/stat_card", label: "Просмотры", value: 0, icon: :eye, tone: :slate %><%= render "admin/shared/stat_card", label: "Посетители", value: 0, icon: :users, tone: :slate %><%= render "admin/shared/stat_card", label: "Опубликовано статей", value: @published_articles_count, icon: :page, tone: :slate %><%= render "admin/shared/stat_card", label: "Среднее время чтения", value: "—", icon: :clock, tone: :slate %></div>
  <div class="analytics-grid"><section class="admin-card analytics-chart"><div class="admin-card-header"><h2>Динамика просмотров</h2></div><%= render "admin/shared/empty_collection", icon: :chart, title: "Данных пока нет", text: "График появится после подключения источника аналитики." %></section><section class="admin-card analytics-content"><div class="admin-card-header"><h2>Контент</h2></div><div class="admin-card-body"><div class="metric-line"><span>Новые статьи</span><strong>0</strong></div><div class="metric-bar"><i style="width:0%"></i></div><div class="metric-line"><span>Обновлено</span><strong>0</strong></div><div class="metric-bar"><i style="width:0%"></i></div><div class="metric-line"><span>Черновики</span><strong><%= @draft_articles_count %></strong></div><div class="metric-bar"><i style="width:0%"></i></div></div></section></div>
  <section class="admin-card analytics-table"><div class="admin-card-header"><h2>Эффективность статей</h2></div><%= render "admin/shared/empty_collection", icon: :chart, title: "Нет данных об эффективности", text: "После подключения аналитики здесь появятся реальные показатели статей." %></section>
</div>
