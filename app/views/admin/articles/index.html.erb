<% content_for :title, "Статьи — DG CMS" %>
<div class="admin-container">
  <div class="page-heading">
    <div><p class="page-eyebrow">Контент</p><h1>Статьи</h1></div>
    <div class="page-heading-actions"><%= link_to new_admin_article_path, class: "admin-button is-primary" do %><%= admin_icon(:plus) %><span>Добавить статью</span><% end %></div>
  </div>
  <section class="collection-panel">
    <div class="filter-row"><label class="filter-search"><%= admin_icon(:search) %><input type="search" placeholder="Поиск по статьям" disabled></label><label class="filter-control"><span>Дата публикации</span><select disabled><option>Сначала новые</option></select></label><label class="filter-control"><span>Категория</span><select disabled><option>Все категории</option></select></label><label class="filter-control"><span>Статус</span><select disabled><option>Все</option></select></label><button class="admin-button filter-columns" type="button" disabled><%= admin_icon(:sliders) %>Столбцы</button></div>
    <div class="collection-table-card"><div class="collection-summary"><span>Всего: <strong><%= @articles.size %></strong></span><span>Опубликовано: <strong><%= @articles.count(&:published?) %></strong></span><span>Черновики: <strong><%= @articles.count(&:draft?) %></strong></span></div>
      <div class="bulk-row"><select disabled><option>Действия с выбранными</option></select><button class="admin-button" type="button" disabled>Применить</button></div>
      <div class="collection-scroll"><table class="collection-table"><thead><tr><th class="check-cell"><input type="checkbox" disabled></th><th>Заголовок</th><th>Категория</th><th>Статус</th><th>Автор</th><th>Дата</th><th></th></tr></thead><tbody>
        <% if @articles.any? %><% @articles.each do |article| %><tr><td class="check-cell"><input type="checkbox" disabled></td><td><%= link_to article.title, admin_article_path(article), class: "table-primary" %></td><td><%= article.category&.name || "—" %></td><td><span class="status-badge is-<%= article.status %>"><%= article.published? ? "Опубликовано" : "Черновик" %></span></td><td><%= admin_display_name(current_user) %></td><td class="material-date"><%= (article.published_at || article.created_at).strftime("%d.%m.%Y") %></td><td><%= link_to admin_article_path(article), class: "dots-button" do %><%= admin_icon(:dots) %><% end %></td></tr><% end %>
        <% else %><tr><td colspan="7"><%= render "admin/shared/empty_collection", icon: :articles, title: "Статей пока нет", text: "Создайте первую статью — она появится в этом списке.", action_label: "Добавить статью", action_path: new_admin_article_path %></td></tr><% end %>
      </tbody></table></div><div class="collection-footer"><span>Показано <%= @articles.size %> из <%= @articles.size %> статей</span></div>
    </div>
  </section>
</div>
