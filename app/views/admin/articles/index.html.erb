<% content_for :title, "Статьи — DG CMS" %>
<div class="admin-container">
  <div class="page-heading">
    <div><p class="page-eyebrow">Контент</p><h1>Статьи</h1></div>
    <div class="page-heading-actions"><%= link_to new_admin_article_path, class: "admin-button is-primary" do %><%= admin_icon(:plus) %><span>Добавить статью</span><% end %></div>
  </div>
  <section class="collection-panel" data-controller="table-columns table-filters" data-table-columns-key-value="articles">
    <div class="filter-row"><label class="filter-search"><%= admin_icon(:search) %><input type="search" placeholder="Поиск по статьям" data-table-filters-target="search" data-action="input->table-filters#apply"></label><label class="filter-control"><span>Дата публикации</span><select data-table-filters-target="date" data-action="change->table-filters#apply"><option value="newest">Сначала новые</option><option value="oldest">Сначала старые</option></select></label><label class="filter-control"><span>Категория</span><select data-table-filters-target="type" data-action="change->table-filters#navigateCategory"><option value="all">Все категории</option><% @categories.each do |category| %><option value="<%= category.id %>" <%= "selected" if category == @selected_category %>><%= category.rendered_name %></option><% end %></select></label><label class="filter-control"><span>Состояние</span><select data-table-filters-target="status" data-action="change->table-filters#apply"><option value="all">Все</option><option value="published">Опубликованные</option><option value="draft">Не опубликованные</option></select></label><%= render "admin/shared/column_picker", columns: [["title", "Заголовок", true], ["access", "Доступ", false], ["author", "Автор", false], ["date", "Дата", false]] %></div>
    <div class="collection-table-card"><div class="collection-summary"><span>Всего: <strong><%= @articles.size %></strong></span><span>Опубликовано: <strong><%= @articles.count(&:published?) %></strong></span><span>Не опубликовано: <strong><%= @articles.count { |article| !article.published? } %></strong></span></div>
      <div class="bulk-row"><select disabled><option>Действия с выбранными</option></select><button class="admin-button" type="button" disabled>Применить</button></div>
      <div class="collection-scroll"><table class="collection-table"><thead><tr><th class="check-cell"><input type="checkbox" aria-label="Выбрать все статьи"></th><th data-column="status" data-fixed-column data-fixed-position="left" class="state-column">Состояние</th><th data-column="title">Заголовок</th><th data-column="access">Доступ</th><th data-column="author">Автор</th><th data-column="date">Дата</th><th data-column="views" data-fixed-column data-fixed-position="right" class="views-column">Просмотры</th><th data-column="id" data-fixed-column data-fixed-position="right" class="id-column">ID</th></tr></thead><tbody>
        <% if @articles.any? %><% @articles.each do |article| %><tr data-table-filters-target="row" data-search="<%= [article.rendered_title, article.slug, article.category&.rendered_name, admin_display_name(current_user)].compact.join(" ") %>" data-name="<%= article.rendered_title %>" data-status="<%= article.published? ? "published" : "draft" %>" data-type="<%= article.category_id || "none" %>" data-date="<%= (article.published_at || article.created_at).to_i %>"><td class="check-cell"><input type="checkbox" aria-label="Выбрать статью <%= article.rendered_title %>"></td><td data-column="status" data-fixed-column data-fixed-position="left" class="state-column"><%= admin_state_indicator(article) %></td><td data-column="title" class="entity-title-cell"><%= link_to article.rendered_title, edit_admin_article_path(article), class: "table-primary entity-primary-link" %><span class="entity-meta"><span class="entity-meta-label">Алиас:</span> <%= article.slug %></span><span class="entity-meta"><span class="entity-meta-label">Категория:</span> <% if article.category %><%= link_to article.category.rendered_name, admin_articles_path(category: article.category_id), class: "entity-meta-link", title: "Показать статьи категории #{article.category.rendered_name}" %><% else %>—<% end %></span></td><td data-column="access"><span class="access-badge is-<%= article.visibility %>"><%= admin_access_label(article) %></span></td><td data-column="author"><%= admin_display_name(current_user) %></td><td data-column="date" class="material-date"><%= (article.published_at || article.created_at).strftime("%d.%m.%Y") %></td><td data-column="views" data-fixed-column data-fixed-position="right" class="views-column"><span class="views-count"><%= article.views_count %></span></td><td data-column="id" data-fixed-column data-fixed-position="right" class="id-column id-value"><%= article.id %></td></tr><% end %>
        <% else %><tr><td colspan="8"><%= render "admin/shared/empty_collection", icon: :articles, title: "Статей пока нет", text: "Создайте первую статью — она появится в этом списке.", action_label: "Добавить статью", action_path: new_admin_article_path %></td></tr><% end %>
      </tbody></table></div><div class="collection-footer"><span><span data-table-filters-target="shown">Показано <%= @articles.size %> из <%= @articles.size %></span> статей</span></div>
    </div>
  </section>
</div>
