<%= form_with model: [:admin, article], data: { controller: "article-form", article_form_current_year_value: Time.current.year, article_form_current_month_pred_value: ContentVariables.month_prepositional }, class: "article-editor-form" do |form| %>
  <div class="editor-breadcrumb"><%= link_to "Статьи", admin_articles_path %><span>/</span><span><%= article.persisted? ? "Редактирование статьи" : "Добавление статьи" %></span></div>
  <div class="editor-heading">
    <h1><%= article.persisted? ? "Редактирование статьи" : "Добавление статьи" %></h1>
    <%= render "admin/shared/editor_actions", cancel_path: admin_articles_path, preview_path: (article.public_path if article.persisted?) %>
  </div>

  <% if article.errors.any? %><div class="error-box"><strong>Проверьте заполнение формы:</strong><ul><% article.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>

  <div class="article-editor-grid" data-controller="tabs">
    <section class="editor-card">
      <div class="editor-tabs"><button type="button" class="is-active" data-tabs-target="tab" data-tabs-name="article" data-action="tabs#show">Статья</button><button type="button" data-tabs-target="tab" data-tabs-name="images" data-action="tabs#show">Изображения</button><button type="button" data-tabs-target="tab" data-tabs-name="seo" data-action="tabs#show">SEO</button></div>

      <div class="editor-panel" data-tabs-target="panel" data-tabs-name="article">
        <div class="form-stack">
          <div class="form-field"><%= form.label :title, "Заголовок статьи" %><%= form.text_field :title, class: "form-input form-input-lg", placeholder: "Введите заголовок", autofocus: true, data: { article_form_target: "titleInput", action: "input->article-form#update" } %></div>
          <div class="form-field"><%= form.label :excerpt, "Краткий анонс" %><%= form.text_area :excerpt, class: "form-textarea", placeholder: "Короткое описание материала", data: { article_form_target: "excerptInput", action: "input->article-form#update" } %><p class="form-hint">Используется в карточках и как запасное SEO-описание.</p></div>
          <div class="form-field"><%= form.label :slug, "URL / Алиас" %><div class="slug-field"><span>goncharoff.pro/<span data-article-form-target="categoryPath"><%= article.category&.slug || "категория" %>/</span></span><%= form.text_field :slug, class: "form-input", placeholder: "adres-stati", data: { article_form_target: "slugInput", action: "input->article-form#lockSlug" } %></div><p class="form-hint">Адрес строится без прослойки /blog: алиас категории и алиас статьи.</p></div>
          <%= render "admin/shared/tiptap_editor", form:, field: :body, label: "Текст статьи", placeholder: "Вставьте или отредактируйте текст статьи…", resizable: true %>
        </div>
      </div>

      <div class="editor-panel article-images-panel" data-tabs-target="panel" data-tabs-name="images" hidden>
        <div class="images-panel-heading"><h2>Изображения статьи</h2><p>Файлы загружаются в единую медиатеку. При импорте Joomla сюда подставляются реальные связанные изображения.</p></div>
        <div class="article-images-grid">
          <% { preview: "Превью", intro: "Изображение вводного текста", fulltext: "Изображение полного текста", main: "Основное изображение" }.each do |role, label| %>
            <% asset = article.public_send("#{role}_image") %>
            <section class="article-image-field">
              <div class="article-image-field-heading"><strong><%= label %></strong><span><%= role.to_s.upcase %></span></div>
              <div class="form-field"><%= label_tag "article_#{role}_image_upload", "Файл изображения" %><%= file_field_tag "article[#{role}_image_upload]", accept: "image/jpeg,image/png,image/webp,image/gif,image/svg+xml", class: "form-input" %><% if asset&.file&.attached? %><p class="form-hint">Текущий файл: <%= link_to asset.file.filename, asset.public_path, target: "_blank", rel: "noopener" %></p><% end %></div>
              <div class="form-field"><%= form.label "#{role}_image_alt", "Alt-текст" %><%= form.text_field "#{role}_image_alt", class: "form-input", placeholder: "Описание изображения для доступности и поиска" %></div>
              <div class="form-field"><%= form.label "#{role}_image_caption", "Подпись" %><%= form.text_area "#{role}_image_caption", class: "form-textarea image-caption-input", placeholder: "Необязательная подпись под изображением" %></div>
            </section>
          <% end %>
        </div>
      </div>

      <div class="editor-panel" data-tabs-target="panel" data-tabs-name="seo" hidden>
        <section class="seo-preview-box" data-controller="snippet-preview" data-snippet-preview-target="preview">
          <div class="seo-preview-heading"><strong>Предпросмотр в поиске</strong><div class="device-switch" role="group" aria-label="Формат предпросмотра"><button type="button" class="is-active" data-snippet-preview-target="desktopButton" data-action="snippet-preview#desktop" aria-pressed="true"><%= admin_icon(:desktop) %><span>Компьютер</span></button><button type="button" data-snippet-preview-target="mobileButton" data-action="snippet-preview#mobile" aria-pressed="false"><%= admin_icon(:phone) %><span>Телефон</span></button></div></div>
          <div class="search-result"><div class="search-site"><span class="search-favicon">DG</span><span><strong>goncharoff.pro</strong><span data-article-form-target="previewUrl">https://goncharoff.pro/категория/adres-stati</span></span></div><div class="search-title" data-article-form-target="previewTitle">Заголовок статьи</div><p data-article-form-target="previewDescription">Краткое описание будущей статьи</p></div>
        </section>
        <div class="form-field field-with-count"><%= form.label :seo_title, "SEO Title" %><%= form.text_field :seo_title, class: "form-input", placeholder: "Если пусто, используется заголовок статьи", maxlength: 60, data: { article_form_target: "seoTitleInput", action: "input->article-form#update" } %><span data-article-form-target="seoCount">0 / 60</span><p class="form-hint">Если оставить пустым, используется заголовок статьи.</p></div>
        <div class="form-field field-with-count"><%= form.label :meta_description, "Meta Description" %><%= form.text_area :meta_description, class: "form-textarea seo-description", placeholder: "Описание страницы в поисковой выдаче", maxlength: 160, data: { article_form_target: "metaInput", action: "input->article-form#update" } %><span data-article-form-target="metaCount">0 / 160</span><p class="form-hint">Если оставить пустым, используется краткий анонс.</p></div>
        <div class="form-field"><%= form.label :canonical_url, "Canonical URL" %><%= form.url_field :canonical_url, class: "form-input", placeholder: "https://goncharoff.pro/kategoriya/adres-stati" %></div>
        <div class="form-field"><%= form.label :meta_keywords, "Meta Keywords" %><%= form.text_area :meta_keywords, class: "form-textarea", placeholder: "Сохраняются для совместимости с legacy-контентом" %></div>
        <div class="form-field"><%= form.label :robots, "Robots" %><%= form.text_field :robots, class: "form-input", placeholder: "Например: noindex, nofollow" %></div>
        <div class="seo-settings-grid"><section class="seo-setting-box"><strong>Индексация</strong><label class="toggle-label"><%= form.check_box :allow_indexing %><span></span>Разрешить индексацию (index)</label><label class="toggle-label"><%= form.check_box :allow_follow %><span></span>Разрешить переход по ссылкам (follow)</label><label class="toggle-label"><%= form.check_box :include_in_sitemap %><span></span>Добавлять в sitemap.xml</label></section><section class="seo-setting-box"><strong>Тип материала</strong><%= form.select :schema_type, [["Article", "Article"], ["BlogPosting", "BlogPosting"], ["NewsArticle", "NewsArticle"]], {}, class: "form-select" %><dl><dt>Автор:</dt><dd><%= admin_display_name(current_user) %></dd><dt>Дата публикации:</dt><dd>из настроек статьи</dd></dl></section></div>
        <section class="seo-setting-box social-settings"><strong>Социальные сети</strong><div class="social-grid"><div><label class="toggle-label"><%= form.check_box :use_seo_for_og %><span></span>Использовать SEO Title и Description для Open Graph</label><label class="toggle-label"><%= form.check_box :use_article_image_for_og %><span></span>Использовать изображение статьи для Open Graph</label></div><div class="og-preview"><span><%= admin_icon(:image) %></span><div><strong>OG-изображение · 1200 × 630</strong><small>Наследуется из статьи</small></div></div><label class="twitter-field">Twitter/X Card: <%= form.select :twitter_card, [["Summary Large Image", "summary_large_image"], ["Summary", "summary"]], {}, class: "form-select" %></label></div></section>
        <details class="advanced-settings"><summary>Расширенные настройки <%= admin_icon(:chevron_right) %></summary><p>Дополнительные SEO-параметры будут добавлены при необходимости.</p></details>
      </div>
    </section>

    <aside class="publication-card"><h2>Публикация</h2><div class="form-field"><%= form.label :status, "Статус" %><%= form.select :status, [["Черновик / не опубликовано", "draft"], ["Опубликовано", "published"], ["В архиве", "archived"]], {}, class: "form-select" %></div><label class="toggle-label"><%= form.check_box :featured %><span></span>Показывать на главной / Featured</label><div class="form-field"><%= form.label :category_id, "Категория" %><%= form.select :category_id, options_for_select(content_scope(Category).order(:name).map { |category| [category.name, category.id, { "data-path": category.slug }] }, article.category_id), { include_blank: "Выберите категорию" }, class: "form-select", data: { article_form_target: "categoryInput", action: "change->article-form#update" } %></div><div class="form-field"><%= form.label :author_id, "Автор" %><%= form.collection_select :author_id, Author.order(:name), :id, :name, { include_blank: "Автор не указан" }, class: "form-select" %></div><div class="form-field"><%= form.label :created_at, "Дата создания" %><%= form.datetime_local_field :created_at, class: "form-input" %></div><div class="form-field"><%= form.label :updated_at, "Дата последнего изменения" %><%= form.datetime_local_field :updated_at, class: "form-input" %></div><div class="form-field"><%= form.label :published_at, "Дата и время публикации" %><%= form.datetime_local_field :published_at, class: "form-input" %></div><div class="form-field"><%= form.label :language, "Язык" %><%= form.text_field :language, class: "form-input", placeholder: "* или ru-RU" %></div><div class="form-field"><%= form.label :visibility, "Доступ" %><%= form.select :visibility, admin_access_options, {}, class: "form-select" %></div><div class="saved-indicator"><span><%= admin_icon(:check) %></span>Данные сохранятся после отправки формы</div></aside>
  </div>
<% end %>
