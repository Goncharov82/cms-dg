<% content_for :title, "Меню сайта — DG CMS" %>
<div class="admin-container"><div class="page-heading"><div><p class="page-eyebrow">Навигация</p><h1>Меню сайта</h1></div><%= link_to new_admin_menu_item_path, class: "admin-button is-primary" do %><%= admin_icon(:plus) %><span>Добавить пункт</span><% end %></div>
  <div class="menu-selector-row"><label><span>Выберите меню</span><select disabled><option>Главное меню</option></select></label><button class="admin-button" disabled><%= admin_icon(:plus) %>Создать меню</button><span class="menu-count">0 пунктов</span></div>
  <section class="collection-panel menu-collection"><div class="filter-row"><label class="filter-search"><%= admin_icon(:search) %><input type="search" placeholder="Поиск по пунктам" disabled></label><label class="filter-control"><span>Тип ссылки</span><select disabled><option>Все типы</option></select></label><label class="filter-control"><span>Статус</span><select disabled><option>Все</option></select></label><button class="admin-button filter-columns" disabled><%= admin_icon(:sliders) %>Столбцы</button><button class="admin-button" disabled><%= admin_icon(:save) %>Сохранить порядок</button></div>
    <div class="collection-summary"><span>Меню: Главное меню</span><span class="status-badge is-draft">Не настроено</span><span>Область: Шапка сайта</span></div><div class="collection-scroll"><table class="collection-table"><thead><tr><th>Название</th><th>Тип</th><th>Привязка</th><th>URL / Алиас</th><th>Открытие</th><th>Статус</th><th></th></tr></thead><tbody><tr><td colspan="7"><%= render "admin/shared/empty_collection", icon: :menu, title: "Пунктов меню пока нет", text: "Каркас меню готов. Добавление пунктов подключим после утверждения внутреннего макета." %></td></tr></tbody></table></div><div class="collection-footer"><span>Показано 0 пунктов</span><span>Порядок можно будет менять перетаскиванием</span></div>
  </section>
</div>
