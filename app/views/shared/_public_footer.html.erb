<footer class="public-footer">
  <div class="public-container">
    <div class="public-footer__main">
      <section class="public-footer__brand" aria-label="Goncharoff.pro">
        <%= link_to root_path, class: "public-footer__logo", aria: { label: "Goncharoff.pro — на главную" } do %>
          <%= image_tag "/images/logo/goncharoffpro.svg", alt: "Goncharoff.pro", width: 304, height: 34, loading: "lazy" %>
        <% end %>
        <p>Практические материалы о сайтах, технологиях, сервисах и продвижении.</p>
      </section>

      <nav class="public-footer__navigation" aria-label="Меню в подвале">
        <h2>Разделы сайта</h2>
        <div class="public-footer__links">
          <% public_main_menu_items.each do |item| %>
            <%= link_to item.rendered_label, public_menu_item_url(item), **public_menu_item_link_options(item) %>
          <% end %>
        </div>
      </nav>

      <section class="public-footer__socials" aria-labelledby="public-footer-socials-title">
        <h2 id="public-footer-socials-title">Мы в соцсетях</h2>
        <div class="public-footer__social-list">
          <%= link_to "https://www.youtube.com/@goncharoff_pro", class: "public-footer__social-link", target: "_blank", rel: "noopener noreferrer", aria: { label: "YouTube-канал Goncharoff.pro" }, title: "YouTube" do %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="4"></rect><path d="m10 9 5 3-5 3z"></path></svg>
          <% end %>
          <%= link_to "https://t.me/goncharoff_pro", class: "public-footer__social-link", target: "_blank", rel: "noopener noreferrer", aria: { label: "Telegram-канал Goncharoff.pro" }, title: "Telegram" do %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 18-7-6.5 16-4-6-4 3z"></path><path d="m10.5 14 4-4"></path></svg>
          <% end %>
          <%= link_to "https://www.tiktok.com/@goncharoff.pro", class: "public-footer__social-link", target: "_blank", rel: "noopener noreferrer", aria: { label: "TikTok Goncharoff.pro" }, title: "TikTok" do %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4v10.5a4.5 4.5 0 1 1-4-4.47"></path><path d="M14 4c.7 2.7 2.3 4.2 5 4.5"></path></svg>
          <% end %>
          <%= link_to "https://vkvideo.ru/@goncharoff_pro", class: "public-footer__social-link", target: "_blank", rel: "noopener noreferrer", aria: { label: "VK Видео Goncharoff.pro" }, title: "VK Видео" do %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="4"></rect><path d="m10 9 5 3-5 3z"></path></svg>
          <% end %>
          <%= link_to "https://rutube.ru/channel/5654900", class: "public-footer__social-link", target: "_blank", rel: "noopener noreferrer", aria: { label: "Rutube-канал Goncharoff.pro" }, title: "Rutube" do %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18V6h7a4 4 0 0 1 0 8H6"></path><path d="m12 14 5 4"></path><circle cx="19" cy="6" r="1.5"></circle></svg>
          <% end %>
          <%= link_to "https://dzen.ru/goncharoff.pro", class: "public-footer__social-link", target: "_blank", rel: "noopener noreferrer", aria: { label: "Дзен Goncharoff.pro" }, title: "Дзен" do %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c0 5-4 9-9 9 5 0 9 4 9 9 0-5 4-9 9-9-5 0-9-4-9-9Z"></path></svg>
          <% end %>
        </div>
      </section>
    </div>

    <div class="public-footer__bottom">
      <div class="public-footer__legal">
        <strong>ИП Гончаров Дмитрий Александрович</strong>
        <span>ИНН 590522985304</span>
        <span>ОГРНИП 322237500027032</span>
      </div>
      <p class="public-footer__copyright"><%= ContentVariables.render("© {YYYY} Goncharoff.pro. Все права защищены.") %></p>
    </div>
  </div>
</footer>
